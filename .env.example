# Copie este arquivo para `.env` e preencha com os seus valores reais.
# NUNCA commite o `.env` — ele está no .gitignore.

# Conexão com o Postgres (ex.: Supabase).
# Formato: postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Chave do painel admin (usada para login em /admin).
ADMIN_KEY=

# Segredo usado para assinar os cookies de sessão (JWT).
# Recomendado: gere um valor aleatório longo, ex.: `openssl rand -hex 32`
SESSION_SECRET=
