# ══════════════════════════════════════════════════════════════
# Realm of Eternity - Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha com os seus valores.
# NUNCA commite o `.env` — ele deve estar no .gitignore.
# ══════════════════════════════════════════════════════════════

# Conexão com o Banco de Dados (PostgreSQL / SQLite)
# PostgreSQL (Supabase, Neon, Railway, etc):
#   Formato: postgresql://usuario:senha@host:5432/banco?sslmode=require
# SQLite (dev local):
#   O banco fica em data/game.db — não precisa configurar esta variável.
DATABASE_URL=

# Chave do painel admin (usada para login em /admin).
# Gere uma chave forte e única para produção.
ADMIN_KEY=

# Segredo usado para assinar os cookies de sessão (JWT).
# Gere com: openssl rand -hex 32
# OU use uma string aleatória longa e complexa.
SESSION_SECRET=

# ══════════════════════════════════════════════════════════════
# Opcionais (descomente se necessário)
# ══════════════════════════════════════════════════════════════

# Porta do servidor (padrão: 3000)
# PORT=3000

# Ambiente: development | production | test
# NODE_ENV=production

# URL do site (para CORS, SEO, manifest)
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Chave PIX para doações (opcional)
# PIX_KEY=

# Webhook de notificação (opcional)
# WEBHOOK_URL=
