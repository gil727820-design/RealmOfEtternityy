# ══════════════════════════════════════════════════════════════
# Realm of Eternity - Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha com os seus valores.
# NUNCA commite o `.env` — ele deve estar no .gitignore.
# ══════════════════════════════════════════════════════════════

# Banco de Dados: SQLite local (padrão)
# O arquivo do banco fica em data/game.db
# Se quiser usar PostgreSQL (produção), descomente DATABASE_URL abaixo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_PATH=./data/game.db

# Chave do painel admin (usada para login em /admin).
ADMIN_KEY=

# Segredo usado para assinar os cookies de sessão (JWT).
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# ══════════════════════════════════════════════════════════════
# Opcionais
# ══════════════════════════════════════════════════════════════

# Porta do servidor (padrão: 3000)
# PORT=3000

# Ambiente: development | production | test
# NODE_ENV=production
