# NUNCA commite o `.env` — ele deve estar no .gitignore.
# ══════════════════════════════════════════════════════════════

# Banco de Dados: JSON local (padrão)
# Os arquivos de dados ficam em data/*.json (um arquivo por coleção).
DATA_DIR=./data

# Chave do painel admin (usada para login em /admin).
ADMIN_KEY=PereiraAdmin2026@

# Segredo usado para assinar os cookies de sessão (JWT).
# Gere com: openssl rand -hex 32
SESSION_SECRET=base64:cW8WItABLlPxzdQCxUGTF5MINy/ZARjVSKWkBgwF6Ms=

# ══════════════════════════════════════════════════════════════
